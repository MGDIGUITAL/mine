{% set initialSlide = 0 %}

{% for media in package.media %}
  {% if media.featured == true %}
   {% set initialSlide = loop.index0 %}
  {% endif %}
{% endfor %}

<div class="media-slider glass-panel-inner package-gallery">
  
  {# Contenedor principal de la imagen/video #}
  <swiper-container
    class="slider premium-slider"
    slides-per-view="1"
    initial-slide="{{ initialSlide }}"
    speed="300"
    navigation="true"
    round-lengths="true"
  >
    {% for media in package.media %}
      <swiper-slide
        class="slide {{ media.type == 'video' ? 'slide-video' : '' }}"
        style="--preview-image: url('https://i.ytimg.com/vi_webp/{{ media.url }}/maxresdefault.webp')"
      >
        {% if media.type == 'image' %}
          <img
            class="slide-image"
            src="{{ media.url }}"
            alt="{{ package.name }}"
          />
        {% elseif media.type == 'video' %}
          <div class="video-wrapper">
            <iframe
              class="slide-frame"
              src=""
              data-src="https://www.youtube.com/embed/{{ media.url }}?color=f59e0b&amp;rel=0&amp;modestbranding=1"
              title="YouTube video player"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        {% endif %}
      </swiper-slide>
    {% endfor %}
  </swiper-container>

  {# Miniaturas (Thumbnails) #}
  <ul class="thumbs premium-thumbs mt-3">
    {% for media in package.media %}
      <li class="thumb glass-input pulse-hover">
        {% if media.type == 'image' %}
          <img
            class="thumb-image"
            src="{{ media.url }}"
            alt="{{ package.name }}"
          />
        {% elseif media.type == 'video' %}
          <div class="thumb-youtube">
            <i class="fas fa-play-circle play-overlay"></i>
            <img
              class="thumb-image"
              src="https://i.ytimg.com/vi_webp/{{ media.url }}/maxresdefault.webp"
              alt="{{ package.name }}"
            />
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>

  {# Botón de pantalla completa #}
  <button class="open-lightbox btn-secondary pulse-glow w-100 mt-2">
    <i class="fas fa-expand"></i> {{ __('View fullscreen') }}
  </button>
</div>
